    "VideoLAN": "videolan@videolan.org"
  },
  "platforms": {
    "tvos": "10.2"
  },
  "source": {
    "http": "https://download.videolan.org/cocoapods/prod/TVVLCKit-3.6.0-c73b779f-dd8bfdba.tar.xz",
