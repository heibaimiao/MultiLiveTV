{
  "name": "vod-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "pack": "npm run build && rm -rf dist && mkdir -p dist && cp -r .next/standalone/. dist/ && cp -r .next/static dist/.next/static && cp -r public dist/public && cp -r config dist/config",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "artplayer": "^5.2.2",
    "hls.js": "^1.6.2",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^20.17.30",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2"
  }
}
